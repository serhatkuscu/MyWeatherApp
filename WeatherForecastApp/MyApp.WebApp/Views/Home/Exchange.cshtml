@{
    ViewData["Title"] = "Exchange";
}

<div class="container mt-5">
    <h1 class="mb-4 text-center">@ViewData["Title"]</h1>
    <div class="card shadow p-4 mx-auto" style="max-width: 500px;">

        <div class="form-group">
            <label for="currency" class="form-label">Para Birimi</label>
            <select id="currency" class="form-select mb-3">
                <option value="EUR">Euro (EUR)</option>
                <option value="USD">Amerikan Doları (USD)</option>
                <option value="GBP">İngiliz Sterlini (GBP)</option>
                <option value="AUD">Avustralya Doları (AUD)</option>
                <option value="CAD">Kanada Doları (CAD)</option>
            </select>

            <label for="amount" class="form-label">Miktar</label>
            <input type="number" id="amount" min="0" class="form-control" placeholder="Miktar giriniz" value="1">
        </div>

        <button id="change" class="btn btn-danger w-100 mt-4">Çevir</button>

        <div class="form-group mt-4">
            <label for="tl" class="form-label">TL Karşılığı</label>
            <input type="text" id="tl" class="form-control" style="background-color: #e9ecef; font-weight: bold;" readonly>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById("change").addEventListener("click", exchangeCurrency);

        async function exchangeCurrency() {
            const amount = document.getElementById("amount").value;
            const selectedCurrency = document.getElementById("currency").value;
            const resultInput = document.getElementById("tl");

            // API Bilgileri
            const apiKey = "v1DpUTmDy2uVOzTZtM8oxQKM5BR9oIgw";
            const url = `https://api.exchangeratesapi.io/v1/latest?access_key=8eed80a2ad169b30ca1be52a9a1b0bc3&symbols=USD,EUR,GBP,AUD,CAD,TRY`;

            try {
                // Yükleniyor efekti için geçici metin
                resultInput.value = "Hesaplanıyor...";

                const response = await fetch(url);

                if (!response.ok) {
                    throw new Error("API yanıt vermedi.");
                }

                const data = await response.json();

                // Mantık: Ücretsiz API Base olarak sadece EUR verir.
                // Çapraz Kur Formülü: (Miktar * TRY_Değeri) / Seçilen_Kurun_EUR_Değeri
                const tryRate = data.rates.TRY;
                const selectedRate = data.rates[selectedCurrency];

                const finalResult = (amount * (tryRate / selectedRate)).toFixed(2);

                // Sonucu ekrana yazdır
                resultInput.value = finalResult + " ₺";

            } catch (error) {
                console.error("Hata:", error);
                alert("Bir hata oluştu. Lütfen API anahtarınızı veya internet bağlantınızı kontrol edin.");
                resultInput.value = "";
            }
        }
    </script>
}